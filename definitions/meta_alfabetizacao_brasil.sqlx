config {
  type: "table",
  description: "Metas anuais de alfabetização no nível nacional (Brasil). Camada Bronze: cópia crua da fonte, sem transformações.",
  tags: ["bronze"]
}

SELECT
  *,
  CURRENT_TIMESTAMP() AS _ingestao_timestamp,
  'basedosdados.br_inep_avaliacao_alfabetizacao.meta_alfabetizacao_brasil' AS _fonte
FROM `basedosdados.br_inep_avaliacao_alfabetizacao.meta_alfabetizacao_brasil`